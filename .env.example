# MetaTrader 5 credentials for the MCP server.
# Copy this file to .env and fill in the values. .env is git-ignored - never commit it.
#
# USE A DEMO ACCOUNT. The guarded launcher (scripts/mt5_mcp_guarded.py) refuses
# to connect to a live real-money account unless MT5_ALLOW_LIVE=1 is set below.

login=12345678
password=your_password
server=MetaQuotes-Demo

# Optional: custom MT5 terminal path (auto-detected if omitted).
# MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# Explicit, per-account opt-in before the agent may EVER touch a real-money
# account. Leave commented out unless you fully accept the risk of real losses.
# MT5_ALLOW_LIVE=1
